# Claude Hub Configuration Example
# Copy this file to .env and fill in your values

# Frontend URL (public URL when deployed)
FRONTEND_URL=https://your-domain.ngrok.io

# TTYD Configuration
TTYD_PATH=ttyd
TTYD_BASE_PORT=10000
DEFAULT_COMMAND=claude

# ============================================
# Feishu OAuth Configuration (Optional)
# If not configured, no authentication is required
# ============================================

# Feishu App ID (from Feishu Open Platform)
FEISHU_APP_ID=cli_a1b2c3d4e5f6g7h8

# Feishu App Secret (from Feishu Open Platform)
FEISHU_APP_SECRET=abcdef1234567890abcdef1234567890

# Feishu Redirect URI (must match what's configured in Feishu Open Platform)
# Format: https://your-domain.com/api/auth/callback
FEISHU_REDIRECT_URI=https://your-domain.ngrok.io/api/auth/callback

# ============================================
# Session Configuration
# ============================================

# Secret key for session management (generate a secure random string)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=your-secret-key-here-change-this-in-production

# Session expiration in days (default: 7)
SESSION_EXPIRE_DAYS=7

# ============================================
# Access Control (Optional)
# ============================================

# Comma-separated list of allowed email addresses
# If empty, any Feishu user can login
AUTH_ALLOWED_EMAILS=user1@company.com,user2@company.com

# Comma-separated list of allowed Feishu Open IDs (recommended, more secure)
# If empty, email whitelist will be used (if configured)
AUTH_ALLOWED_OPEN_IDS=your_open_id_here
